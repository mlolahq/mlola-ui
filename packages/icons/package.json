{
  "name": "@mlola-ui/icons",
  "version": "1.0.9",
  "description": "Mlola Glyph DNA: currentColor SVG icons with stable metaphors",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./glyphs.css"
  ],
  "files": [
    "dist",
    "glyphs.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./glyphs.css": "./glyphs.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "license": "MIT",
  "author": "Mlola",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlolahq/mlola-ui.git",
    "directory": "packages/icons"
  },
  "homepage": "https://ui.mlola.com",
  "bugs": {
    "url": "https://github.com/mlolahq/mlola-ui/issues"
  },
  "keywords": [
    "mlola",
    "ui",
    "icons",
    "svg",
    "currentcolor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module"
}
