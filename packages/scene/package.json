{
  "name": "@mlola-ui/scene",
  "version": "1.0.9",
  "description": "Optional lightweight spatial presentation for Mlola UI",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./src/scene.css"
  ],
  "files": [
    "dist",
    "src/scene.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stage": {
      "types": "./dist/stage.d.ts",
      "default": "./dist/stage.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "default": "./dist/primitives.js"
    },
    "./scene.css": "./src/scene.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "license": "MIT",
  "author": "Mlola",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlolahq/mlola-ui.git",
    "directory": "packages/scene"
  },
  "homepage": "https://ui.mlola.com",
  "bugs": {
    "url": "https://github.com/mlolahq/mlola-ui/issues"
  },
  "keywords": [
    "mlola",
    "ui",
    "3d",
    "scene",
    "perspective",
    "css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module"
}
