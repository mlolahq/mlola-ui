          ],
          "does": "Jump to the minimum or maximum."
        },
        {
          "keys": [
            "PageUp",
            "PageDown"
          ],
          "does": "Move by a larger step."
        }
      ],
      "transitions": [
        {
          "on": "pointer down on the track, or drag the thumb",
          "set": "the value from the pointer position, snapped to the step",
          "to": "within min and max"
        }
      ]
    }
