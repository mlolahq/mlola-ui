{
  "name": "@mlola-ui/motion",
  "version": "1.0.9",
  "description": "Reduced-motion-aware kinetic primitives for Mlola UI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./motion.css"
  ],
  "files": [
    "dist",
    "motion.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./physics": {
      "types": "./dist/spring.d.ts",
      "default": "./dist/spring.js"
    },
    "./raf": {
      "types": "./dist/raf.d.ts",
      "default": "./dist/raf.js"
    },
    "./motion.css": "./motion.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "license": "MIT",
  "author": "Mlola",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlolahq/mlola-ui.git",
    "directory": "packages/motion"
  },
  "homepage": "https://ui.mlola.com",
  "bugs": {
    "url": "https://github.com/mlolahq/mlola-ui/issues"
  },
  "keywords": [
    "mlola",
    "ui",
    "motion",
    "spring",
    "animation",
    "css"
  ],
  "publishConfig": {
    "access": "public"
  }
}
