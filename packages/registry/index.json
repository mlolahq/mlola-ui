{
  "$schema": "./schema/registry-index.schema.json",
  "schemaVersion": 2,
  "name": "mlola-ui",
  "version": "1.0.6",
  "homepage": "https://ui.mlola.com",
  "themeContract": {
    "attribute": "data-theme",
    "modeAttribute": "data-mode",
    "default": "graphite",
    "channels": [
      "color",
      "typography",
      "geometry",
      "density",
      "depth",
      "motion",
      "texture",
      "rhythm",
      "icons"
    ],
    "invariants": [
      "semantics",
      "behavior",
      "accessibility",
      "component-anatomy"
    ]
  },
  "themes": [
    {
      "id": "graphite",
      "name": "Graphite",
      "genre": "Product & AI",
      "description": "Neutral graphite, crisp hairlines, and ink that stays out of the way."
    },
    {
      "id": "atelier",
      "name": "Atelier Umami",
      "genre": "Editorial & Craft",
      "description": "Warm cotton paper, artisanal ink, and an amber signal."
    },
    {
      "id": "machined",
      "name": "Machined Titanium",
      "genre": "Industrial & Telemetry",
      "description": "Aerospace telemetry, compact precision, and high contrast."
    },
    {
      "id": "aerogel",
      "name": "Aerogel Glass",
      "genre": "Liquid AI & Optics",
      "description": "Optical luminescence, liquid refraction, and specular depth."
    },
    {
      "id": "nordic",
      "name": "Nordic Earth",
      "genre": "Organic & Minimal",
      "description": "Forest moss, fjord stone, terracotta, and organic calm."
    }
  ],
  "themeAliases": {},
  "description": "Mlola UI open-source registry for source-copy components.",
  "categories": [
    {
      "id": "actions",
      "title": "Actions",
      "description": "Buttons and menus that make something happen."
    },
    {
      "id": "forms",
      "title": "Forms",
      "description": "Controls for entering and choosing values."
    },
    {
      "id": "data",
      "title": "Data display",
      "description": "People, status and records at a glance."
    },
    {
      "id": "feedback",
      "title": "Feedback",
      "description": "What happened, what is happening, and what is loading."
    },
    {
      "id": "navigation",
      "title": "Navigation",
      "description": "Moving between pages, views and commands."
    },
    {
      "id": "overlays",
      "title": "Overlays",
      "description": "Layers that sit above the page."
    },
    {
      "id": "layout",
      "title": "Layout",
      "description": "Structure: disclosure, panes and space."
    }
  ],
  "components": [
    "accordion",
    "alert",
    "avatar",
    "badge",
    "breadcrumb",
    "button",
    "card",
    "carousel",
    "checkbox",
    "command-menu",
