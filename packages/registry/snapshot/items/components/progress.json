      "values": [
        "sm",
        "md",
        "lg"
      ],
      "default": "md"
    },
    {
      "component": "CircularProgress",
      "prop": "tone",
      "values": [
        "primary",
        "info",
        "success",
        "warning",
        "danger"
      ],
      "default": "primary"
