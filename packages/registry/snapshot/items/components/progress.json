{
  "$schema": "../schema/registry-item.schema.json",
  "schemaVersion": 2,
  "name": "progress",
  "type": "registry:ui",
  "title": "Progress",
  "description": "Horizontal and circular progress indicators with variants and indeterminate mode",
  "category": "feedback",
  "tags": [
    "feedback",
    "loading",
    "status"
  ],
  "usage": {
    "importPath": "{{aliases.components}}/progress",
    "exportName": "Progress",
