{
  "$schema": "../schema/registry-item.schema.json",
  "schemaVersion": 2,
  "name": "badge",
  "type": "registry:ui",
  "title": "Badge",
  "description": "A small status or label badge with color variants, dot indicator, and removal",
  "category": "data",
  "variants": [
    "default",
    "primary",
    "secondary",
    "success",
    "warning",
    "danger",
    "outline"
  ],
  "sizes": [
    "sm",
    "md",
    "lg"
  ],
  "tags": [
    "status",
    "label",
    "indicator"
  ],
  "usage": {
    "importPath": "{{aliases.components}}/badge",
    "exportName": "Badge",
    "isDefault": false
  },
  "registryDependencies": [],
  "engineDependencies": {
    "@mlola-ui/icons": "^1.0.3"
  },
  "files": [
    {
      "path": "packages/components/_internal/react.ts",
      "target": "{{aliases.components}}/_internal/react.ts",
      "type": "registry:ui",
      "integrity": "sha256-SH63/haiB4Q93uFjMIMe5xZbaxENu3VI+GcidV8HELM="
    },
    {
      "path": "packages/components/badge/badge.tsx",
      "target": "{{aliases.components}}/badge.tsx",
      "type": "registry:ui",
      "integrity": "sha256-flEH8S2jZ/64n3Y/ROhC9+9rvF7wXaN0xLcMMwqNOVQ="
    }
  ],
  "themeContract": {
    "attribute": "data-theme",
    "modeAttribute": "data-mode",
    "compatibleThemes": [
      "graphite",
      "atelier",
      "machined",
      "aerogel",
      "nordic"
    ]
  }
}
