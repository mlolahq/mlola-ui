{
  "$schema": "../schema/registry-item.schema.json",
  "schemaVersion": 2,
  "name": "button",
  "type": "registry:ui",
  "title": "Button",
  "description": "A versatile button component with multiple variants, sizes, and states",
  "category": "actions",
  "tags": [
    "interactive",
    "form",
    "navigation"
  ],
  "usage": {
    "importPath": "{{aliases.components}}/button",
    "exportName": "Button",
    "isDefault": false
  },
  "registryDependencies": [],
  "engineDependencies": {
    "@mlola-ui/motion": "^1.0.6"
  },
  "options": [
    {
      "component": "Button",
      "prop": "size",
      "values": [
        "sm",
        "md",
        "lg",
        "icon"
      ],
      "default": "md"
    },
    {
      "component": "Button",
      "prop": "variant",
      "values": [
        "primary",
        "secondary",
        "subtle",
        "danger",
        "outline",
        "link"
      ],
      "default": "primary"
    }
  ],
  "variants": [
    "primary",
    "secondary",
    "subtle",
    "danger",
    "outline",
    "link"
  ],
  "sizes": [
    "sm",
    "md",
    "lg",
    "icon"
  ],
  "files": [
    {
      "path": "packages/components/_internal/react.ts",
      "target": "{{aliases.components}}/_internal/react.ts",
      "type": "registry:ui",
      "integrity": "sha256-SH63/haiB4Q93uFjMIMe5xZbaxENu3VI+GcidV8HELM="
    },
    {
      "path": "packages/components/button/button.tsx",
      "target": "{{aliases.components}}/button.tsx",
      "type": "registry:ui",
      "integrity": "sha256-khqYxcV3hlZ+Q+cYNTRXEpAfIijDFSvkuDJXMPtlk7g="
    }
  ],
  "themeContract": {
    "attribute": "data-theme",
    "modeAttribute": "data-mode",
    "compatibleThemes": [
      "graphite",
      "atelier",
      "machined",
      "aerogel",
      "nordic"
    ]
  }
