{
  "$schema": "../schema/registry-item.schema.json",
  "schemaVersion": 2,
  "category": "actions",
  "description": "A keyboard-navigable dropdown menu with icons, shortcuts, and danger items",
  "name": "dropdown-menu",
  "tags": [
    "menu",
    "overlay",
    "navigation",
    "dropdown"
  ],
  "title": "Dropdown Menu",
  "type": "registry:ui",
  "usage": {
    "importPath": "{{aliases.components}}/dropdown-menu",
    "exportName": "DropdownMenu",
    "isDefault": false
  },
  "registryDependencies": [],
  "engineDependencies": {
    "@mlola-ui/behavior": "^1.4.2",
    "@mlola-ui/icons": "^1.4.2"
  },
  "options": [
    {
      "component": "DropdownMenu",
      "prop": "align",
      "values": [
        "start",
        "end"
      ],
      "default": "start"
    },
    {
      "component": "DropdownMenu",
      "prop": "variant",
      "values": [
        "button",
        "icon"
      ],
      "default": "button",
      "description": "`button` shows the trigger with a chevron; `icon` is a small icon-only trigger, such as a card's or a column's \"…\" menu."
    }
  ],
  "variants": [
    "button",
    "icon"
  ],
  "sizes": [],
  "files": [
    {
      "path": "packages/components/_internal/anchor.ts",
      "target": "{{aliases.components}}/_internal/anchor.ts",
      "type": "registry:ui",
      "integrity": "sha256-4qsvIzYQYC+yEhaJ6BDYX18Qdw7isKhzBOEnivnVgOY="
    },
    {
      "path": "packages/components/_internal/floating.ts",
      "target": "{{aliases.components}}/_internal/floating.ts",
      "type": "registry:ui",
      "integrity": "sha256-Yk3QfedtNE5m4oG506sYzf5CGE1yIt8gBzImSkXtMbY="
    },
    {
      "path": "packages/components/_internal/react.ts",
      "target": "{{aliases.components}}/_internal/react.ts",
      "type": "registry:ui",
      "integrity": "sha256-INfds1J2f1MLpN6kBXz0GkfBEMIiRlhv0DXX455qAZo="
    },
    {
      "path": "packages/components/dropdown-menu/dropdown-menu.tsx",
      "target": "{{aliases.components}}/dropdown-menu.tsx",
      "type": "registry:ui",
      "integrity": "sha256-TSAsDWcx8mVwLdZVEaCrO0Fkeuiaui7Jw/BbZQmJH1Y="
    }
  ],
  "themeContract": {
    "attribute": "data-theme",
    "modeAttribute": "data-mode",
    "compatibleThemes": [
      "graphite",
      "atelier",
      "machined",
      "aerogel",
      "nordic"
    ]
  }
}
