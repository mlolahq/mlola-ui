    },
    {
      "path": "packages/components/input/input.tsx",
      "target": "{{aliases.components}}/input.tsx",
      "type": "registry:ui",
      "integrity": "sha256-lbbheo+ydQTzyujTf0W7DD96TogOjifCyqj9c3h3W0g="
    }
  ],
  "themeContract": {
