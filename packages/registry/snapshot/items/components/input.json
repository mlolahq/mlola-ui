        "sm",
        "md",
        "lg"
      ],
      "default": "md"
    },
    {
      "component": "Input",
      "prop": "variant",
      "values": [
        "default",
        "filled",
        "subtle"
      ],
      "default": "default"
    }
  ],
  "variants": [],
  "sizes": [],
  "files": [
