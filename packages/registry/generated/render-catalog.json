  "functions": {},
  "$defs": {
    "DynamicString": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding"
        }
      ]
    },
    "DynamicNumber": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding"
        }
      ]
    },
    "DynamicBoolean": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding"
        }
      ]
    },
    "Action": {
      "type": "object",
      "description": "What a press sends back to the agent: an event with a name and the values it needs.",
      "properties": {
        "event": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$"
            },
            "context": {
              "type": "object",
              "maxProperties": 32,
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  {
                    "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding"
                  }
                ]
              }
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event"
      ],
      "additionalProperties": false
    },
    "Option": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "label",
        "value"
      ],
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "description": "The surface's look, by name. Colors, type and shape come from the theme and are never set one by one.",
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "graphite",
            "atelier",
            "machined",
            "aerogel",
            "nordic"
          ],
          "default": "graphite"
        },
        "mode": {
          "type": "string",
          "enum": [
            "light",
            "dark",
            "system"
          ],
          "default": "system"
        }
      },
      "additionalProperties": false
    },
    "anyComponent": {
      "oneOf": [
        {
          "$ref": "#/components/Stack"
        },
        {
          "$ref": "#/components/Row"
        },
        {
          "$ref": "#/components/Grid"
        },
        {
