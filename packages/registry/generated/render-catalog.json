        },
        {
          "$ref": "#/components/Accordion"
        },
        {
          "$ref": "#/components/AccordionItem"
        },
        {
          "$ref": "#/components/Input"
        },
        {
          "$ref": "#/components/Textarea"
        },
        {
          "$ref": "#/components/Select"
        },
        {
          "$ref": "#/components/RadioGroup"
        },
        {
          "$ref": "#/components/Checkbox"
        },
        {
          "$ref": "#/components/Switch"
        },
        {
          "$ref": "#/components/Slider"
        },
        {
          "$ref": "#/components/DatePicker"
        },
        {
          "$ref": "#/components/Button"
        },
        {
          "$ref": "#/components/Badge"
        },
