            "children"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "Accordion": {
      "type": "object",
      "description": "A list of sections that open and close. Its children are AccordionItem components.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Accordion"
            },
            "children": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
              "description": "The AccordionItem components, in order."
