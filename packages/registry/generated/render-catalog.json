            "label": {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 120
                },
                {
                  "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding"
                }
              ],
              "description": "What the tabs choose between, for a screen reader."
            },
            "children": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
              "description": "The Tab components, in order."
            },
            "variant": {
              "type": "string",
              "enum": [
                "default",
                "pills",
                "enclosed"
              ],
              "default": "default",
              "description": "The look of the tab row."
            }
          },
          "required": [
            "component",
            "label",
            "children"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "Tab": {
      "type": "object",
