{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui.mlola.com/a2ui/catalog/v1",
  "title": "Mlola Render catalog",
  "description": "Mlola UI components for interfaces an agent composes at runtime. Every component is accessible by construction and follows the surface's theme; an agent picks named values (tone, variant, size) and never writes a color, size or class. Generated from Mlola UI 1.10.3; check messages with `npx mlola-ui render check` or the check_render MCP tool, which also hold what a schema cannot (one root, no loops, heading order, values in range).",
  "catalogId": "https://ui.mlola.com/a2ui/catalog/v1",
  "components": {
    "Stack": {
      "type": "object",
      "description": "Places its children in a column with the theme's spacing. Use it as the root of most surfaces.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Stack"
            },
            "children": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
              "description": "The components inside, top to bottom."
            }
          },
          "required": [
            "component",
            "children"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "Row": {
      "type": "object",
      "description": "Places its children side by side and wraps them on a narrow screen. Use it for a row of buttons or badges.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Row"
            },
            "children": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
              "description": "The components inside, start to end."
            }
          },
          "required": [
            "component",
            "children"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "Grid": {
      "type": "object",
      "description": "Places its children in equal columns that collapse to one column on a phone.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Grid"
            },
            "children": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
              "description": "The components inside, in reading order."
            },
            "columns": {
              "type": "string",
              "enum": [
                "1",
                "2",
                "3",
                "4",
                "6"
              ],
              "description": "How many columns on a wide screen. Leave it out to fit as many as the width allows."
            }
          },
          "required": [
            "component",
            "children"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "Heading": {
      "type": "object",
      "description": "A heading. Levels follow the page outline: never skip a level going deeper.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Heading"
            },
            "text": {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 120
                },
                {
                  "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding"
                }
              ],
              "description": "The heading's words."
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6,
              "default": 2,
              "description": "The outline level, 1 to 6. Inside a chat a surface usually starts at 2."
            }
          },
          "required": [
            "component",
            "text"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "Text": {
      "type": "object",
      "description": "A paragraph of plain text.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Text"
            },
            "text": {
              "$ref": "#/$defs/DynamicString",
              "description": "The words. Line breaks are kept; markup is shown as text."
            }
          },
          "required": [
            "component",
            "text"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "Card": {
      "type": "object",
      "description": "Groups related content on a surface of its own.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Card"
            },
            "children": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
              "description": "The card's content."
            },
            "variant": {
              "type": "string",
              "enum": [
                "default",
                "elevated",
                "glass",
                "specular"
              ],
              "default": "default",
              "description": "How the card stands off the page."
            }
          },
          "required": [
            "component",
            "children"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "Alert": {
      "type": "object",
      "description": "A message about the surface: a confirmation, a warning or an error. Warnings and errors interrupt a screen reader; calmer tones are announced politely.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Alert"
            },
            "title": {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 120
                },
                {
                  "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding"
                }
              ],
              "description": "A short summary, read first."
            },
            "text": {
              "$ref": "#/$defs/DynamicString",
              "description": "What happened and what to do about it."
            },
            "tone": {
              "type": "string",
              "enum": [
                "neutral",
                "info",
                "success",
                "warning",
                "danger"
              ],
              "default": "neutral",
              "description": "What the message means."
            },
            "variant": {
              "type": "string",
              "enum": [
                "card",
                "soft"
              ],
              "default": "card",
              "description": "A card, or a tinted band across the surface."
            }
          },
          "required": [
            "component",
            "text"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "EmptyState": {
      "type": "object",
      "description": "Says that there is nothing here yet and what to do next.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "EmptyState"
            },
            "title": {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 120
                },
                {
                  "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding"
                }
              ],
              "description": "What is empty, in a few words."
            },
            "description": {
              "$ref": "#/$defs/DynamicString",
              "description": "What to do next."
            },
            "children": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
              "description": "Actions, usually one or two Buttons."
            },
            "size": {
              "type": "string",
              "enum": [
                "inline",
                "page"
              ],
              "default": "inline",
              "description": "inline inside a surface, page when it fills one."
            }
          },
          "required": [
            "component",
            "title"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "Tabs": {
      "type": "object",
      "description": "Shows one panel at a time, chosen from a row of tabs. Its children are Tab components.",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Tabs"
