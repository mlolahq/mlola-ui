{
  "$schema": "../schema/registry-item.schema.json",
  "schemaVersion": 2,
  "name": "hover-card",
  "type": "registry:ui",
  "title": "Hover Card",
  "description": "A preview card that opens when the pointer rests on a link or name, and on keyboard focus",
  "category": "overlays",
  "tags": [
    "hover card",
    "preview",
    "profile",
    "popover"
  ],
  "usage": {
    "importPath": "{{aliases.components}}/hover-card",
    "exportName": "HoverCard",
    "isDefault": false
  },
  "registryDependencies": [],
  "engineDependencies": {
    "@mlola-ui/behavior": "^1.0.6"
  },
  "options": [
    {
      "component": "HoverCard",
      "prop": "align",
      "values": [
        "start",
        "center",
        "end"
      ],
      "default": "start"
    },
    {
      "component": "HoverCard",
      "prop": "side",
      "values": [
        "top",
        "bottom",
        "left",
        "right"
      ],
      "default": "bottom"
    }
  ],
  "variants": [],
  "sizes": [],
  "files": [
    {
      "path": "packages/components/_internal/anchor.ts",
      "target": "{{aliases.components}}/_internal/anchor.ts",
