      "integrity": "sha256-SH63/haiB4Q93uFjMIMe5xZbaxENu3VI+GcidV8HELM="
    },
    {
      "path": "packages/components/time-picker/time-picker.tsx",
      "target": "{{aliases.components}}/time-picker.tsx",
