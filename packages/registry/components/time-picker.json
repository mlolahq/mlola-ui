{
  "$schema": "../schema/registry-item.schema.json",
  "schemaVersion": 2,
  "name": "time-picker",
  "type": "registry:ui",
  "title": "Time Picker",
  "description": "A time field of typeable spinbuttons in 12- or 24-hour time, with a quick list; the value is always HH:MM",
  "category": "forms",
  "tags": [
    "time",
    "picker",
    "form",
    "clock"
  ],
  "usage": {
    "importPath": "{{aliases.components}}/time-picker",
    "exportName": "TimePicker",
    "isDefault": false
  },
  "registryDependencies": [
    "input",
    "popover"
  ],
  "engineDependencies": {
    "@mlola-ui/icons": "^1.0.2"
  },
  "files": [
    {
      "path": "packages/components/_internal/react.ts",
