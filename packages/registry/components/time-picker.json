      "integrity": "sha256-OyIfJN6xVv6TwUYtRirkemJe5VMcu2HXxjaJj8fvu9I="
    },
    {
      "path": "packages/components/time-picker/times.ts",
      "target": "{{aliases.components}}/time-picker/times.ts",
      "type": "registry:ui",
      "integrity": "sha256-V/4uqFZPn9gVnyx8cB9vwp/RocmTYaPmLxjfy8DPQOI="
    }
  ],
  "themeContract": {
