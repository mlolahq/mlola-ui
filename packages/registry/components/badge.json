{
  "$schema": "../schema/registry-item.schema.json",
  "schemaVersion": 2,
  "name": "badge",
  "type": "registry:ui",
  "title": "Badge",
  "description": "A small status or label badge with color variants, dot indicator, and removal",
  "category": "data",
  "tags": [
    "status",
    "label",
    "indicator"
  ],
  "usage": {
    "importPath": "{{aliases.components}}/badge",
    "exportName": "Badge",
    "isDefault": false
  },
  "registryDependencies": [],
  "engineDependencies": {
    "@mlola-ui/icons": "^1.0.9"
  },
  "options": [
    {
      "component": "Badge",
      "prop": "size",
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "default": "md"
    },
    {
      "component": "Badge",
      "prop": "tone",
      "values": [
        "neutral",
        "primary",
        "info",
        "success",
        "warning",
        "danger"
      ],
      "default": "neutral"
    },
    {
      "component": "Badge",
      "prop": "variant",
      "values": [
        "soft",
        "solid",
        "outline"
      ],
      "default": "soft"
    }
  ],
  "variants": [
    "soft",
    "solid",
    "outline"
  ],
  "sizes": [
    "sm",
    "md",
    "lg"
  ],
  "files": [
    {
      "path": "packages/components/_internal/react.ts",
      "target": "{{aliases.components}}/_internal/react.ts",
      "type": "registry:ui",
      "integrity": "sha256-SH63/haiB4Q93uFjMIMe5xZbaxENu3VI+GcidV8HELM="
    },
    {
      "path": "packages/components/badge/badge.tsx",
      "target": "{{aliases.components}}/badge.tsx",
      "type": "registry:ui",
      "integrity": "sha256-flEH8S2jZ/64n3Y/ROhC9+9rvF7wXaN0xLcMMwqNOVQ="
    }
  ],
  "themeContract": {
    "attribute": "data-theme",
    "modeAttribute": "data-mode",
    "compatibleThemes": [
      "graphite",
      "atelier",
      "machined",
      "aerogel",
      "nordic"
    ]
  }
}
