{
  "$schema": "../schema/registry-item.schema.json",
  "schemaVersion": 2,
  "name": "color-picker",
  "type": "registry:ui",
  "title": "Color Picker",
  "description": "A color field with a saturation area, hue and opacity, hex, rgb or oklch, an eyedropper, presets and a contrast check",
  "category": "forms",
  "tags": [
    "color",
    "color",
    "picker",
    "oklch",
    "hex",
    "form"
  ],
  "usage": {
    "importPath": "{{aliases.components}}/color-picker",
    "exportName": "ColorPicker",
    "isDefault": false
  },
  "registryDependencies": [
    "input",
    "popover"
  ],
  "engineDependencies": {
    "@mlola-ui/icons": "^1.1.13"
  },
  "options": [
    {
      "component": "ColorPicker",
      "prop": "format",
      "values": [
        "hex",
        "rgb",
        "oklch"
      ],
      "default": "hex"
    }
  ],
  "variants": [],
  "sizes": [],
  "files": [
    {
      "path": "packages/components/_internal/react.ts",
      "target": "{{aliases.components}}/_internal/react.ts",
      "type": "registry:ui",
      "integrity": "sha256-INfds1J2f1MLpN6kBXz0GkfBEMIiRlhv0DXX455qAZo="
    },
    {
      "path": "packages/components/color-picker/color-picker.tsx",
      "target": "{{aliases.components}}/color-picker.tsx",
      "type": "registry:ui",
      "integrity": "sha256-/UyEbxqknsHheX444Imc3WphyixZbvj8hGL+r+zyG5w="
    },
    {
      "path": "packages/components/color-picker/color.ts",
      "target": "{{aliases.components}}/color-picker/color.ts",
      "type": "registry:ui",
      "integrity": "sha256-YqSgYjzn7XfPWAHuyzbwOhbg/ScaSfB7V73e9w+OjJs="
    }
  ],
  "themeContract": {
    "attribute": "data-theme",
    "modeAttribute": "data-mode",
    "compatibleThemes": [
      "graphite",
      "atelier",
      "machined",
      "aerogel",
      "nordic"
    ]
  }
}
