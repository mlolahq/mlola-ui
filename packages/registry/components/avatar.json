    },
    {
      "path": "packages/components/avatar/avatar.tsx",
      "target": "{{aliases.components}}/avatar.tsx",
      "type": "registry:ui",
      "integrity": "sha256-61GyO7vZiTEe05z8si1gXKrzgm7I9kN+OFdgk0H8u4Y="
