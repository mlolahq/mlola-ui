    "media",
    "user",
    "identity"
  ],
  "usage": {
    "importPath": "{{aliases.components}}/avatar",
    "exportName": "Avatar",
    "isDefault": false
  },
  "registryDependencies": [],
  "engineDependencies": {},
  "options": [
    {
      "component": "Avatar",
      "prop": "size",
      "values": [
        "xs",
        "sm",
        "md",
        "lg",
        "xl"
      ],
      "default": "md"
    },
    {
      "component": "Avatar",
      "prop": "status",
      "values": [
        "online",
        "offline",
        "away",
        "busy"
      ]
    }
