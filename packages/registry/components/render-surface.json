{
  "$schema": "../schema/registry-item.schema.json",
  "schemaVersion": 2,
  "name": "render-surface",
  "title": "Render Surface",
  "description": "Draws the interface an agent composed as A2UI messages, checked against the Mlola Render catalog and built from Mlola components",
  "category": "data",
  "tags": [
    "agent",
    "a2ui",
    "generative",
    "render"
  ],
  "type": "registry:ui",
  "usage": {
    "importPath": "{{aliases.components}}/render-surface",
    "exportName": "RenderSurface",
    "isDefault": false
  },
  "registryDependencies": [
    "accordion",
    "alert",
    "avatar",
    "badge",
    "button",
    "card",
    "checkbox",
    "date-picker",
    "empty-state",
    "input",
    "progress",
    "radio-group",
    "select",
    "slider",
    "table",
    "tabs",
    "textarea",
    "toggle"
  ],
  "engineDependencies": {
    "@mlola-ui/behavior": "^1.10.2"
  },
  "options": [
    {
      "component": "RenderSurface",
      "prop": "theme",
      "values": [
        "surface",
        "inherit"
      ],
      "default": "surface",
      "description": "\"surface\" draws in the theme the agent named; \"inherit\" keeps the theme of the page around it."
    }
  ],
  "variants": [],
  "sizes": [],
  "files": [
    {
      "path": "packages/components/_internal/react.ts",
      "target": "{{aliases.components}}/_internal/react.ts",
      "type": "registry:ui",
      "integrity": "sha256-INfds1J2f1MLpN6kBXz0GkfBEMIiRlhv0DXX455qAZo="
    },
    {
      "path": "packages/components/render-surface/render-surface.tsx",
      "target": "{{aliases.components}}/render-surface.tsx",
      "type": "registry:ui",
      "integrity": "sha256-3L4CcYBHjwb1QyKGCygC4NEPL4TajSZiNcMzy4Uf0IM="
    }
  ],
  "themeContract": {
    "attribute": "data-theme",
    "modeAttribute": "data-mode",
    "compatibleThemes": [
      "graphite",
      "atelier",
      "machined",
      "aerogel",
      "nordic"
    ]
  }
}
