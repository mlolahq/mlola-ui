{
  "$schema": "../schema/registry-item.schema.json",
  "schemaVersion": 2,
  "name": "slider",
  "type": "registry:ui",
  "title": "Slider",
  "description": "An accessible single-value slider with keyboard support and pointer dragging",
  "category": "forms",
  "tags": [
    "form",
    "input",
    "range"
  ],
  "usage": {
    "importPath": "{{aliases.components}}/slider",
    "exportName": "Slider",
    "isDefault": false
  },
  "registryDependencies": [],
  "engineDependencies": {
    "@mlola-ui/behavior": "^1.0.9"
  },
  "options": [
    {
      "component": "Slider",
      "prop": "size",
      "values": [
        "sm",
        "md"
      ],
      "default": "md"
    }
  ],
  "variants": [],
  "sizes": [
    "sm",
    "md"
  ],
  "files": [
    {
      "path": "packages/components/_internal/react.ts",
      "target": "{{aliases.components}}/_internal/react.ts",
      "type": "registry:ui",
      "integrity": "sha256-SH63/haiB4Q93uFjMIMe5xZbaxENu3VI+GcidV8HELM="
    },
    {
      "path": "packages/components/slider/slider.tsx",
      "target": "{{aliases.components}}/slider.tsx",
      "type": "registry:ui",
      "integrity": "sha256-l+VrBqPYHIIcemiVixxwDxNDB0HEMmYRZekx/H5HroQ="
    }
  ],
  "themeContract": {
    "attribute": "data-theme",
    "modeAttribute": "data-mode",
    "compatibleThemes": [
      "graphite",
      "atelier",
      "machined",
      "aerogel",
      "nordic"
    ]
  }
}
