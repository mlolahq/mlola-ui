{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "baseUrl": ".",
    "paths": {
      "@mlola-ui/motion": ["./packages/motion/src/index.ts"],
      "@mlola-ui/motion/*": ["./packages/motion/src/*"],
      "@mlola-ui/scene": ["./packages/scene/src/index.ts"],
      "@mlola-ui/scene/*": ["./packages/scene/src/*"],
      "@mlola-ui/behavior": ["./packages/behavior/src/index.js"],
      "@mlola-ui/behavior/logic": ["./packages/behavior/src/logic.d.ts"],
      "@mlola-ui/behavior/document": ["./packages/behavior/src/document.d.ts"],
      "@mlola-ui/icons": ["./packages/icons/src/index.tsx"],
      "@mlola-ui/icons/*": ["./packages/icons/src/*"]
    }
  },
  "include": [
    "packages/components/**/*.ts",
    "packages/components/**/*.tsx",
    "packages/blocks/**/*.ts",
    "packages/blocks/**/*.tsx",
    "packages/pages/**/*.ts",
    "packages/pages/**/*.tsx",
    "packages/templates/**/*.ts",
    "packages/templates/**/*.tsx"
  ],
  "exclude": ["node_modules", "**/dist/**"]
}
